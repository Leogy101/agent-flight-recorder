include README.md LICENSE CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md CHANGELOG.md
recursive-include docs *.md *.png *.webm
recursive-include schema *.json
recursive-include fixtures *.json *.jsonl *.md
recursive-include examples *.py *.json
recursive-include benchmarks *.py
recursive-include scripts *.mjs
recursive-include tests *.py *.mjs
recursive-include .github/workflows *.yml
include viewer/package.json viewer/package-lock.json viewer/tsconfig.json viewer/vite.config.ts viewer/index.html
recursive-include viewer/src *.ts *.tsx *.css *.png
recursive-include viewer/scripts *.ts *.mjs
recursive-include src/agent_flight_recorder/static *
global-exclude __pycache__ *.py[cod] .DS_Store
